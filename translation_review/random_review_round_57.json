  "samples": [
    {
      "uid": "46_395527872_3",
      "scene": "Dialog106062_Chat",
      "rows": [
        {
          "uid": "46_1953513013_3",
          "key": "Dialog106062_Chat_36",
          "speaker_ja": "トト",
          "ko": "모두가 마음을 하나로 하여 힘을 합쳐 하나의 일을 이루는 것은 가장 기쁜 결말이다.",
          "source": "みんなが心を一つにして力を合わせ、一つの事を成し遂げるのは、最も嬉しい結末だ。"
        },
        {
          "uid": "46_395527872_3",
          "key": "Dialog106062_Chat_37",
          "speaker_ja": "詩",
          "ko": "마지막 공연이 호랑이 씨의 첫 무대, 분명 잊을 수 없는 추억이 되네요!",
          "source": "最後の公演がトラさんの初舞台、きっと忘れられない思い出になりますね！"
        },
        {
          "uid": "46_673786383_3",
          "key": "Dialog106062_Chat_38",
          "speaker_ja": "座長",
          "ko": "그렇다면 좋았다… … 안심했어. 그 아이가 너의 동료가 되었다고 듣고, 앞으로는 잘 부탁한다.",
          "source": "それならよかった……安心したわい。あの子がお前さんらの仲間になったと聞いてな、これからはよろしく頼む。"
        }
      ]
    },
    {
      "uid": "46_1542249033_3",
      "scene": "Dialog103118_Chat",
      "rows": [
        {
          "uid": "46_1542249033_3",
          "key": "Dialog103118_Chat_0",
          "speaker_ja": "ファンティーヌ",
          "ko": "좋은 소식과 나쁜 소식이 있습니다.",
          "source": "いい知らせと悪い知らせがあるわ。"
        },
        {
          "uid": "46_2105050275_3",
          "key": "Dialog103118_Chat_1",
          "speaker_ja": "ファンティーヌ",
          "ko": "좋은 소식은, 당신들이 설치한 장치가, 병균을 검지했어.",
          "source": "いい知らせは、あなたたちが設置した装置が、病菌を検知したわ。"
        }
      ]
    },
    {
      "uid": "46_1359942914_3",
      "scene": "Dialog102045_End",
      "rows": [
        {
          "uid": "46_1249480993_3",
          "key": "Dialog102045_End_1",
          "speaker_ja": "フェイ",
          "ko": "그래, 나도 조금 들렸다! 전에 들었던 적이 있는 곡처럼.",
          "source": "うん、私もちょっと聞こえた！前に聞いたことのある曲みたい。"
        },
        {
          "uid": "46_1359942914_3",
          "key": "Dialog102045_End_2",
          "speaker_ja": "詩",
          "ko": "유명한 곡같은 생각이 든다… … 음…",
          "source": "有名な曲みたいな気がする……うーん……コクなら知ってるかもしれない。"
        },
        {
          "uid": "46_1450962672_3",
          "key": "Dialog102045_End_3",
          "speaker_ja": "フェイ",
          "ko": "그럼 우선 리포트에 위치를 기록하고 나중에 회사 모두에게 물어보자.",
          "source": "それではまずレポートに位置を記録して、あとで会社のみんなに聞いてみよう。"
        }
      ]
    },
    {
      "uid": "46_1024928608_3",
      "scene": "Dialog101052_End",
      "rows": [
        {
          "uid": "46_869854101_3",
          "key": "Dialog101052_End_2",
          "speaker_ja": "フェイ",
          "ko": "우리 파티의 것, 판틴은 우리가 도울 생각이 없다고 생각하고 이것을 주선했을지도 모른다.",
          "source": "我々のパーティーのものだ、ファンティーヌは私たちが手伝うつもりがないと思ってこれを手配したのかもしれない。"
        },
        {
          "uid": "46_1024928608_3",
          "key": "Dialog101052_End_3",
          "speaker_ja": "詩",
          "ko": "반드시 도와주세요! 하지만 일이 있다면 먼저 그쪽을 정리하자.",
          "source": "必ず手伝うぜ！でも、仕事があるならまずそっちを片付けよう。"
        }
      ]
    },
    {
      "uid": "46_130062132_3",
      "scene": "Dialog108065_Chat",
      "rows": [
        {
          "uid": "46_1878978854_3",
          "key": "Dialog108065_Chat_1",
          "speaker_ja": "ミリア",
          "ko": "했어! 리가 1위다! 리가 가장 빠르다!",
          "source": "やった！リーが一位だ！リーが一番速い！"
        },
        {
          "uid": "46_130062132_3",
          "key": "Dialog108065_Chat_2",
          "speaker_ja": "ガゼット",
          "ko": "……언제부터 달리기 경쟁이 됐어. 글쎄, 좋아하게 놀면 좋다.",
          "source": "……いつから走り競争になったんだァ。まあ、好きに遊べばいいさ。"
        },
        {
          "uid": "46_770182474_3",
          "key": "Dialog108065_Chat_3",
          "speaker_ja": "ミリア",
          "ko": "그건 봐! 앞쪽에 더 퀘스트가 있어! 리더, 리는 '방뱅'의 게임을 하고 싶다!",
          "source": "あれ見て！前の方にもっとクエストがあるよ！リーダー、リーは「バンバン」のゲームをやりたい！"
        }
      ]
    }
  ]
