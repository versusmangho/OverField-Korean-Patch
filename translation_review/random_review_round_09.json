  "samples": [
    {
      "uid": "46_675596398_3",
      "scene": "Dialog100011_Begin",
      "rows": [
        {
          "uid": "46_275292314_3",
          "key": "Dialog100011_Begin_3",
          "speaker_ja": "フェイ",
          "ko": "저는 리더 가이드이므로 반드시 귀하의 유닛에 가입합니다.",
          "source": "私はリーダーのガイドですから、必ずあなたのユニットに参加します。"
        },
        {
          "uid": "46_675596398_3",
          "key": "Dialog100011_Begin_4",
          "speaker_ja": "フェイ",
          "ko": "입니다만, 이전도 말했듯이, 통상 유닛은 3명 편성이 이상입니다. 좀 더 멤버를 모으자!",
          "source": "ですが、以前もお話しした通り、通常ユニットは3名編成が理想です。もう少しメンバーを集めましょう！"
        },
        {
          "uid": "46_1081571082_3",
          "key": "Dialog100011_Begin_5",
          "speaker_ja": "フェイ",
          "ko": "이건 인사부의 대원 모집 신청서예요. 지금 다른 일을 맡고 있지 않은 프론티어를 모집할 수 있어요.",
          "source": "こちらが人事部の隊員募集申請フォームです。現在手が空いているサルベージャーを募集できます。"
        }
      ]
    },
    {
      "uid": "46_1155676672_3",
      "scene": "Dialog230035_End",
      "rows": [
        {
          "uid": "46_1756950883_3",
          "key": "Dialog230035_End_3",
          "speaker_ja": "ナオキ",
          "ko": "헤헤, 그렇게 말해 주셔서 안심했어! 그런 큰 건 아니지만.",
          "source": "へへ、そう言ってもらえて安心したぜ！そんな大きなもんじゃねぇけどさ。"
        },
        {
          "uid": "46_1155676672_3",
          "key": "Dialog230035_End_4",
          "speaker_ja": "ナオキ",
          "ko": "실은 히카리 선배가 지금의 시모하라의 축제를 본 적이 없기 때문에, 체험시키고 싶고.",
          "source": "実はヒカリ先輩が今の下原の祭りを見たことないから、体験させてあげたくて。"
        },
        {
          "uid": "46_1173030274_3",
          "key": "Dialog230035_End_5",
          "speaker_ja": "ナオキ",
          "ko": "하지만…",
          "source": "でも……食べ物買っただけじゃ祭りっていうより、ただの集まりみたいだよな。"
        }
      ]
    },
    {
      "uid": "46_1150423360_3",
      "scene": "Dialog104047_Chat",
      "rows": [
        {
          "uid": "46_1093015541_3",
          "key": "Dialog104047_Chat_1",
          "speaker_ja": "ドーラ",
          "ko": "아, 네... 괜찮습니다.",
          "source": "あ、はい……大丈夫です。"
        },
        {
          "uid": "46_1150423360_3",
          "key": "Dialog104047_Chat_2",
          "speaker_ja": "コクマ",
          "ko": "진단 결과, 특히 이상이 없었습니다. 그건 그렇고, 무엇입니까?",
          "source": "診断の結果、特に異常ありませんでした。ところで、それはなんですか？"
        },
        {
          "uid": "46_1385874979_3",
          "key": "Dialog104047_Chat_3",
          "speaker_ja": "詩",
          "ko": "아, 이거? 탐색중에 주웠다. 안정 장치 같지만 이미 깨진 것 같다. 앞으로 기술부에 도착하려고 생각한다.",
          "source": "あ、これ？探索中に拾ったんだ。安定装置っぽいけど、もう壊れているみたい。これから技術部に届てようと思うんだ。"
        }
      ]
    },
    {
      "uid": "46_345355655_3",
      "scene": "Dialog106041_Chat",
      "rows": [
        {
          "uid": "46_327903538_3",
          "key": "Dialog106041_Chat_12",
          "speaker_ja": "リコ",
          "ko": "다른 다른! 로타 미식 축제이기 때문에—",
          "source": "違う違う！ロータ美食祭だから—"
        },
        {
          "uid": "46_345355655_3",
          "key": "Dialog106041_Chat_13",
          "speaker_ja": "イェンイェン",
          "ko": "찾으러 온 사람, 복장에서 보고 사자춤의 사람 같았지요, 토토쨩?",
          "source": "探しに来た人、服装から見て獅子舞の人みたいでしたよね、トトちゃん？"
        },
        {
          "uid": "46_1633251250_3",
          "key": "Dialog106041_Chat_14",
          "speaker_ja": "トト",
          "ko": "네, 사자 모양의 큰 머리가있었습니다. 호랑이 언니의 모자와 매우 비슷했습니다.",
          "source": "はい、獅子の形をした大きな頭がありました。トラお姉さんの帽子によく似てました。"
        }
      ]
    },
    {
      "uid": "46_1173665584_3",
      "scene": "Dialog103135_Chat",
      "rows": [
        {
          "uid": "46_1310231637_3",
          "key": "Dialog103135_Chat_16",
          "speaker_ja": "詩",
          "ko": "그 비극은 당신의 책임이 아니에요.",
          "source": "あの悲劇は、あなたの責任じゃないですよ。"
        },
        {
          "uid": "46_1173665584_3",
          "key": "Dialog103135_Chat_17",
          "speaker_ja": "ナオキ",
          "ko": "아무래도 이것과 같은 모양의 것이 어디에도 없었던 것이다. 라는 것은, 이 스카프는 동생의 것인가?",
          "source": "どうりでこれと同じ模様のものがどこにもなかったわけだ。てことは、このスカーフは弟さんのものなのか？"
        },
        {
          "uid": "46_20187277_3",
          "key": "Dialog103135_Chat_18",
          "speaker_ja": "謎の少女",
          "ko": "네……하지만…… 만들기가 조금 다릅니다.",
          "source": "はい……でも……作りが少し違います。"
        }
      ]
    }
  ]
}
