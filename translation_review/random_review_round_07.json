    {
      "uid": "46_1711635020_3",
      "scene": "Dialog108044_Chat",
      "rows": [
        {
          "uid": "46_1121870786_3",
          "key": "Dialog108044_Chat_0",
          "speaker_ja": "ミリア",
          "ko": "이겼다 - 리가 변이체을 쓰러뜨리는 퀘스트를 달성했어!",
          "source": "勝ったーーリーが灰物を倒すクエストを達成したよ！"
        },
        {
          "uid": "46_1711635020_3",
          "key": "Dialog108044_Chat_1",
          "speaker_ja": "フェイ",
          "ko": "밀리아의 총의 솜씨는 꽤군요, 가제티아도 칼의 사용법이 능숙합니다만, 현실에서는 조심하지 않으면 안 됩니다.",
          "source": "ミリアの銃の腕前はなかなかですね、ガゼッティアもナイフの使い方が上手ですが、現実では気を付けないといけませんよ。"
        },
        {
          "uid": "46_1156081272_3",
          "key": "Dialog108044_Chat_2",
          "speaker_ja": "ミリア",
          "ko": "리는 어느 세계에 있어도 사격이 제일 잘해!",
          "source": "リーはどっちの世界にいても、射撃が一番上手いよ！"
        }
      ]
    },
    {
      "uid": "46_810287863_3",
      "scene": "Dialog230025_End",
      "rows": [
        {
          "uid": "46_1902548286_3",
          "key": "Dialog230025_End_9",
          "speaker_ja": "詩",
          "ko": "그럼 붙여넣기도 하자. 만약 전의 주인도 로터의 프론티어라면, 분명 찾아 줄게.",
          "source": "それから張り紙もしよう。もし前の飼い主もロータのサルベージャーなら、きっと見つけてくれるよ。"
        },
        {
          "uid": "46_810287863_3",
          "key": "Dialog230025_End_10",
          "speaker_ja": "詩",
          "ko": "운이 좋으면, 곧바로 재회할 수 있을지도!",
          "source": "運が良ければ、すぐに再会できるかも！"
        }
      ]
    },
    {
      "uid": "46_806844505_3",
      "scene": "Dialog108083_Chat",
      "rows": [
        {
          "uid": "46_724152617_3",
          "key": "Dialog108083_Chat_1",
          "speaker_ja": "詩",
          "ko": "저기 사람이 있습니다, 아까는 보이지 않았는데…",
          "source": "あそこに人がいます、さっきは見えなかったのに……"
        },
        {
          "uid": "46_806844505_3",
          "key": "Dialog108083_Chat_2",
          "speaker_ja": "フェイ",
          "ko": "할머니… 랩의 사람에게는 보이지 않지만, 왜 이런 곳에…",
          "source": "おばあさん……ですね。ラボの人には見えませんが、どうしてこんなところに……？"
        },
        {
          "uid": "46_288480679_3",
          "key": "Dialog108083_Chat_3",
          "speaker_ja": "ミリア",
          "ko": "이봐, 할머니가 마녀님?",
          "source": "ねえ、おばあちゃんが魔女さまなの？"
        }
      ]
    },
    {
      "uid": "46_2108420072_3",
      "scene": "Dialog104114_End",
      "rows": [
        {
          "uid": "46_1062193081_3",
          "key": "Dialog104114_End_1",
          "speaker_ja": "フェイ",
          "ko": "이 근처에서 발생한 미니 필드의 영향으로, 변이체이 늘어났지요.",
          "source": "この近くで発生したミニフィールドの影響で、灰物が増えたんでしょうね。"
