      ]
    },
    {
      "uid": "46_1018904633_3",
      "scene": "Dialog100001_Chat",
      "rows": [
        {
          "uid": "46_1385287856_3",
          "key": "Dialog100001_Chat_0",
          "speaker_ja": "詩",
          "ko": "페이 씨, 여기 있었습니까? 찾았습니다~!",
          "source": "フェイさん、ここにいたんですか！探しましたよ～！"
        },
        {
          "uid": "46_1018904633_3",
          "key": "Dialog100001_Chat_1",
          "speaker_ja": "詩",
          "ko": "필드에서 이상한 것을 발견했습니다. 도대체 이것은…",
          "source": "フィールドで変なものを見つけたんです。一体これは……"
        },
        {
          "uid": "46_1213399345_3",
          "key": "Dialog100001_Chat_2",
          "speaker_ja": "フェイ",
          "ko": "버섯 모양의 봉제 인형?",
          "source": "キノコの形をしたぬいぐるみ、ですか？"
        }
      ]
    },
    {
      "uid": "46_594605634_3",
      "scene": "Dialog104011_Chat",
      "rows": [
        {
          "uid": "46_1792198159_3",
          "key": "Dialog104011_Chat_2",
          "speaker_ja": "フェイ",
          "ko": "이전도 조금 설명했지만, 마터란, 시민 여러분에게 초상 현상을 설명하는 연구 기구군요.",
          "source": "この前もちょっとだけ説明しましたけど、マターとは、市民のみなさんに超常現象を説明する研究機構ですね。"
        },
        {
          "uid": "46_594605634_3",
          "key": "Dialog104011_Chat_3",
          "speaker_ja": "フェイ",
          "ko": "우리가 필드를 탐색하고 있는 동안, 마터도 현실 세계에서 필드 현상, 예를 들어 '엠프티아이' 등을 조사하고 있어요.",
          "source": "私たちがフィールドを探索している間に、マターも現実世界でフィールド現象、例えば「エンプティアイ」などを調査しているんですよ。"
        },
        {
          "uid": "46_379769490_3",
          "key": "Dialog104011_Chat_4",
          "speaker_ja": "詩",
          "ko": "아! 마타는, 로터와 옛부터 협동으로 조사하고 있는, 그 마터군요!",
          "source": "あ！マターって、ロータと昔から協同で調査している、あのマターですね！"
        }
      ]
    },
    {
      "uid": "46_470118093_3",
      "scene": "Dialog104074_End",
      "rows": [
        {
          "uid": "46_470118093_3",
          "key": "Dialog104074_End_0",
          "speaker_ja": "詩",
          "ko": "그러고 보니 저기에서 도라 씨를 찾았어요. 하지만 잘 생각하면 두 번 모두 똑같은 장소였습니다 ...... 조금 이상하지 않습니까?",
          "source": "そういえば、あそこでドーラさんを見つけましたね。でもよく考えたら2回ともまったく同じ場所でした……ちょっと変じゃないですか？"
        },
        {
          "uid": "46_1685562185_3",
          "key": "Dialog104074_End_1",
          "speaker_ja": "フェイ",
          "ko": "여기에 변이체 변이체의 흔적이 남아 있습니다! 변이체 자체는 보이지 않지만 ......",
          "source": "ここに灰物変異体の痕跡が残っています！変異体自体は見かけませんが……"
        }
      ]
    }
