  "samples": [
    {
      "uid": "46_1636325556_3",
      "scene": "Dialog107014_Chat",
      "rows": [
        {
          "uid": "46_1373902212_3",
          "key": "Dialog107014_Chat_7",
          "speaker_ja": "ファンティーヌ",
          "ko": "기술부가 조사했어. 그녀의 지원 링에서 보낸 데이터는 정상입니다. 요청의 송수신도 문제 없어.",
          "source": "技術部が調べたわ。彼女のサポートリングから送られてくるデータは正常よ。リクエストの送受信も問題ないわ。"
        },
        {
          "uid": "46_1636325556_3",
          "key": "Dialog107014_Chat_8",
          "speaker_ja": "リン",
          "ko": "우리가 아는 한, 분명 「스노우 돔」에 열중하고 있을 뿐, 왜냐하면 수정 구슬 있어요!",
          "source": "うちの知る限り、きっと「スノードーム」に夢中になってるだけっす、だって水晶玉っすよ！"
        },
        {
          "uid": "46_1720211136_3",
          "key": "Dialog107014_Chat_9",
          "speaker_ja": "詩",
          "ko": "수정 구슬을 좋아하니?",
          "source": "水晶玉が好きなの？"
        }
      ]
    },
    {
      "uid": "46_400554989_3",
      "scene": "Dialog220093_Chat",
      "rows": [
        {
          "uid": "46_5531634_3",
          "key": "Dialog220093_Chat_30",
          "speaker_ja": "パンオン",
          "ko": "음, 선배……지금의 선배는…",
          "source": "せ、先輩……今の先輩は……ちょっとバカみたいに見えて……"
        },
        {
          "uid": "46_400554989_3",
          "key": "Dialog220093_Chat_31",
          "speaker_ja": "レクシー",
          "ko": "뭐…… 바보? ! 고혼! …… 아, 알았다 알았다. 네가 정직하고 좋은 아이인 건 알고 있어. 선배를 걱정하고, 결국 본심과는 다른 것을 입으로 하는 것도 이해할 수 있다…",
          "source": "なっ……バカ？！ゴホン！……ああ、分かった分かった。君が正直で良い子なのは知ってるよ。先輩を心配して、つい本心とは違うことを口にするのも理解できる……"
        },
        {
          "uid": "46_1984598576_3",
          "key": "Dialog220093_Chat_32",
          "speaker_ja": "パンオン",
          "ko": "……에? 그……",
          "source": "……え？ その……周りのサルベージャーからそう聞いたので……"
        }
      ]
    },
    {
      "uid": "46_876096137_3",
      "scene": "Dialog230019_End",
      "rows": [
        {
          "uid": "46_673386258_3",
          "key": "Dialog230019_End_10",
          "speaker_ja": "フェイ",
          "ko": "광장도 해변도 좋아하지만, 로타의 빌딩도 좋아합니다 ...",
          "source": "広場もビーチも大好きですが、ロータのビルも大好きです…"
        },
        {
          "uid": "46_876096137_3",
          "key": "Dialog230019_End_11",
          "speaker_ja": "フェイ",
          "ko": "——그러나 나는 이전에 이 좋아하는 마음을 표현하는 것을 몰랐다.",
          "source": "——しかし、私は以前この好きな気持ちを言い表すのが知らなかった。"
        },
        {
          "uid": "46_1971725307_3",
          "key": "Dialog230019_End_12",
          "speaker_ja": "博士",
          "ko": "어머? 그럼 어째서 지금은 낼 수 있게 된 거야?",
          "source": "あら？じゃあどうして今は出せるようになったの？"
        }
      ]
    },
    {
      "uid": "46_804616604_3",
      "scene": "Dialog102064_Talk",
      "rows": [
        {
          "uid": "46_1350107823_3",
          "key": "Dialog102064_Talk_0",
          "speaker_ja": "フェイ",
          "ko": "(소성) 이 근처에서… … 멜로디가…",
          "source": "（小声）この辺りで……メロディが……聞こえる？"
        },
        {
          "uid": "46_804616604_3",
          "key": "Dialog102064_Talk_1",
          "speaker_ja": "詩",
          "ko": "(소성) 아직… 하지만… 어째서 소성으로…",
          "source": "（小声）まだ…でも…なんで小声で…途切れ途切れに話してるの？"
        },
        {
          "uid": "46_1249198999_3",
          "key": "Dialog102064_Talk_2",
          "speaker_ja": "フェイ",
          "ko": "(소성)도…",
          "source": "（小声）だって……——（大声）バレた！"
        }
      ]
    },
    {
      "uid": "46_978686341_3",
      "scene": "Dialog105115_End",
      "rows": [
        {
          "uid": "46_481694624_3",
          "key": "Dialog105115_End_3",
          "speaker_ja": "詩",
          "ko": "그래, 변이체은 우리에게 맡겨! 하지만 점점 강해지고 있다고 생각합니다.",
          "source": "うん、灰物はあたしたちに任せて！でもどんどん強くなってる気がします。"
        },
        {
          "uid": "46_978686341_3",
          "key": "Dialog105115_End_4",
          "speaker_ja": "フェイ",
          "ko": "코부시 씨가 있어 주면…",
          "source": "小伏さんがいてくれたら……いえ、小伏さんも言ってました、私も強いって……私にもできます！"
        },
        {
          "uid": "46_99925407_3",
          "key": "Dialog105115_End_5",
          "speaker_ja": "フェイ",
          "ko": "토토쨩은 코부시 씨에게. 그쪽이 안전하기 때문에——",
          "source": "トトちゃんは小伏さんのところへ。そっちの方が安全ですから——"
        }
      ]
    }
  ]
