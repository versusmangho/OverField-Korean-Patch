  "samples": [
    {
      "uid": "46_1768753299_3",
      "scene": "Dialog220031_Chat",
      "rows": [
        {
          "uid": "46_817045176_3",
          "key": "Dialog220031_Chat_0",
          "speaker_ja": "詩",
          "ko": "그렇다, 그 수수께끼의 대답, 알았어요!",
          "source": "そうだ、あの謎々の答え、わかりましたよ！"
        },
        {
          "uid": "46_1768753299_3",
          "key": "Dialog220031_Chat_1",
          "speaker_ja": "詩",
          "ko": "대답은 「달」이지요? 사키 씨가 말한 하늘의 \"달\"!",
          "source": "答えは「月」ですよね？咲さんが言ってた、空の「月」！"
        },
        {
          "uid": "46_1554531785_3",
          "key": "Dialog220031_Chat_2",
          "speaker_ja": "咲",
          "ko": "맞았습니다. 네, 대답은 달입니다.",
          "source": "当てられましたね。はい、答えは月です。"
        }
      ]
    },
    {
      "uid": "46_1435768831_3",
      "scene": "Dialog109072_Chat",
      "rows": [
        {
          "uid": "46_1420719711_3",
          "key": "Dialog109072_Chat_8",
          "speaker_ja": "コク",
          "ko": "방금전의 약간의 해프닝 덕분에… … 이 페스티벌에, 조금 기대해 버렸기 때문에.",
          "source": "先ほどのちょっとしたハプニングのおかげで……このフェスに、少し期待してしまいましたから。"
        },
        {
          "uid": "46_1435768831_3",
          "key": "Dialog109072_Chat_9",
          "speaker_ja": "詩",
          "ko": "좋았다! 그럼 모두 가자!",
          "source": "よかった！じゃあみんなで行きましょう！"
        }
      ]
    },
    {
      "uid": "46_1734388958_3",
      "scene": "Dialog106032_End",
      "rows": [
        {
          "uid": "46_1099838952_3",
          "key": "Dialog106032_End_2",
          "speaker_ja": "リコ",
          "ko": "그렇지만 서포트 링이라든지 아직 잘 모르지만…",
          "source": "でもサポートリングとかまだよく分かんないけど……"
        },
        {
          "uid": "46_1734388958_3",
          "key": "Dialog106032_End_3",
          "speaker_ja": "詩",
          "ko": "괜찮아요, 지금은 리더에게 조작을 맡기면 좋으니까, 따라와주세요!",
          "source": "大丈夫ですよ、今はリーダーに操作を任せればいいから、ついて来てくださいね！"
        },
        {
          "uid": "46_1094701940_3",
          "key": "Dialog106032_End_4",
          "speaker_ja": "リコ",
          "ko": "따라온다고, 내가 떨어지는 것 같잖아…",
          "source": "ついて来るって、あたしが落ちこぼれみたいじゃん……"
        }
      ]
    },
    {
      "uid": "46_526685795_3",
      "scene": "Dialog102036_Talk",
      "rows": [
        {
          "uid": "46_650475208_3",
          "key": "Dialog102036_Talk_1",
          "speaker_ja": "フェイ",
          "ko": "대단한 시! 나는 이런 걸 몰라.",
          "source": "すごいね詩！私はこういうのあまりわからないや。"
        },
        {
          "uid": "46_526685795_3",
          "key": "Dialog102036_Talk_2",
          "speaker_ja": "詩",
          "ko": "나는 이전에 시계 장인이 시계를 수리하는 것을 여러 번 보고 있었고, 보고 있는 동안 조금만 요령을 기억했다.",
          "source": "私は以前、時計職人が時計を修理するのを何度も見ていて、見ているうちに少しだけコツを覚えたんだ。"
        },
        {
          "uid": "46_90069943_3",
          "key": "Dialog102036_Talk_3",
          "speaker_ja": "詩",
          "ko": "하지만 정말 재미있는, 지금 베하임의 세계도 돌기 시작한, 마치 사쿠라바의 수차처럼!",
          "source": "でも本当に面白い、今ベハイムの世界も回り始めた、まるで桜庭の水車みたいに！"
        }
      ]
    },
    {
      "uid": "46_919476841_3",
      "scene": "Dialog108032_Chat",
      "rows": [
        {
          "uid": "46_1974791758_3",
          "key": "Dialog108032_Chat_50",
          "speaker_ja": "ハーミット",
          "ko": "문헌의 원본은 낡은 것입니다만, 나의 일족에는 전속의 사본 장인이 있어, 몇 세대마다 새롭게 써사하고 있습니다.",
          "source": "文献の原本は古いものですが、私の一族には専属の写本職人がいて、数世代ごとに新たに書き写しています。"
        },
        {
          "uid": "46_919476841_3",
          "key": "Dialog108032_Chat_51",
          "speaker_ja": "ハーミット",
          "ko": "실은 이번 연구과제의 사본도 가져오고 있는 것입니다. 그것은 나의 조상 호세임 헤르메트의 시대에 발견된 낡은 양피지의 두루마리의 사본으로, 거기에 기록된 사건이야말로 당시 직접《아톨 가설》로부터 아우터랜드 학파를 낳은 근원이며, 그것이 전설의 마…",
          "source": "実は今回の研究課題の写本も持ってきているのです。それは、私の先祖ホセイム・ハーミットの時代に発見された古い羊皮紙の巻物の写本で、そこに記された出来事こそが当時直接《アトール仮説》からアウターランド学派を生み出した源であり、それが伝説の魔…"
        },
        {
          "uid": "46_1431861763_3",
          "key": "Dialog108032_Chat_52",
          "speaker_ja": "ハーミット",
          "ko": "… … 그거? 그 사본은 어디에 두었습니까? 최근에 회수했을 뿐인데…",
          "source": "……あれ？その写本はどこに置いたんだったかな？最近回収したばかりなのに……"
        }
      ]
    }
  ]
}
