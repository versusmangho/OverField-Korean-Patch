  "pool_size": 7989,
  "samples": [
    {
      "uid": "46_263355059_3",
      "scene": "Dialog200001_Chat",
      "rows": [
        {
          "uid": "46_172314801_3",
          "key": "Dialog200001_Chat_17",
          "speaker_ja": "フェイ",
          "ko": "그 화 냄비 전문점과 필드 F20의 사이에 오버랩 현상이 발생하고 있는 것을 증명합니다. 그래서 연구부가 현장 형성의 비밀을 밝힐 수 있을지도 모른다.",
          "source": "その火鍋専門店とフィールドF20の間にオーバーラップ現象が発生していることを証明します。それで、研究部がフィールド形成の秘密を解明できるかもしれません。"
        },
        {
          "uid": "46_263355059_3",
          "key": "Dialog200001_Chat_18",
          "speaker_ja": "イェンイェン",
          "ko": "아아아아! 마지막 대사가 잡혔다!",
          "source": "あああぁっ！最後のセリフが取られちゃった！"
        },
        {
          "uid": "46_1738277596_3",
          "key": "Dialog200001_Chat_19",
          "speaker_ja": "フェイ",
          "ko": "미안해요…… 옌옌의 이야기가 길어질 것 같아서, 리더와 시 씨가 기다리기 힘드실까 봐요.",
          "source": "ごめんなさい……イェンイェンが長く話しそうだったので、リーダーと詩さんが待ちきれないかと思って。"
        }
      ]
    },
    {
      "uid": "46_997497950_3",
      "scene": "Dialog100064_Begin",
      "rows": [
        {
          "uid": "46_517398737_3",
          "key": "Dialog100064_Begin_0",
          "speaker_ja": "フェイ",
          "ko": "전방에 변이체이 나타났습니다. 여러분, 조심하세요!",
          "source": "前方に灰物が現れました。みなさん、気をつけてください！"
        },
        {
          "uid": "46_997497950_3",
          "key": "Dialog100064_Begin_1",
          "speaker_ja": "詩",
          "ko": "지상에 있는 것은… … 혹시 서류입니까?",
          "source": "地面にあるのって……もしかして書類ですか？"
        },
        {
          "uid": "46_35668488_3",
          "key": "Dialog100064_Begin_2",
          "speaker_ja": "フェイ",
          "ko": "아마 그렇습니다. 애물은 오버랩과 함께 나타나는 경우가 많기 때문에.",
          "source": "おそらくそうです。灰物はオーバーラップと一緒に現れることが多いので。"
        }
      ]
    },
    {
      "uid": "46_1488935196_3",
      "scene": "Activity100012_Chat",
      "rows": [
        {
          "uid": "46_1642151215_3",
          "key": "Activity100012_Chat_9",
          "speaker_ja": "詩",
          "ko": "우리에게는, 여기는 단지의 폐허로 보입니다만, 유령에게 있어서는 테마 파크 같은 장소일지도 모릅니다?",
          "source": "あたしたちには、ここはただの廃墟に見えますけど、幽霊にとってはテーマパークみたいな場所なのかもしれませんよ？"
        },
        {
          "uid": "46_1488935196_3",
          "key": "Activity100012_Chat_10",
          "speaker_ja": "フェイ",
          "ko": "그렇게 말하면… … 확실히 조금 귀엽네요.",
          "source": "そう言われると……確かにちょっとかわいらしいですね。"
        },
        {
          "uid": "46_2125684107_3",
          "key": "Activity100012_Chat_11",
          "speaker_ja": "詩",
          "ko": "이 유령들도 함께 배제합니까?",
          "source": "この幽霊たちも一緒に排除するんですか？"
        }
      ]
    },
    {
      "uid": "46_1584020342_3",
      "scene": "Dialog103077_Chat",
      "rows": [
        {
          "uid": "46_1604265440_3",
          "key": "Dialog103077_Chat_8",
          "speaker_ja": "フェイ",
          "ko": "좋았고, 분명히 알게 된 것 같습니다. 그럼, 우선 자기 소개를 할까요?",
          "source": "良かった、どうやら分かってくれたみたいです。それじゃ、まず自己紹介をしましょうか？"
        },
        {
          "uid": "46_1584020342_3",
          "key": "Dialog103077_Chat_9",
          "speaker_ja": "フェイ",
          "ko": "음… … 우리는 로타 연구소 소속의 프론티어입니다. 나는 페이, 여기는 시 씨입니다. 당신의 이름은?",
          "source": "えっと……私たちはロータラボラトリー所属のサルベージャーです。私はフェイ、こちらは詩さんです。あなたの名前は？"
        },
        {
          "uid": "46_547964899_3",
          "key": "Dialog103077_Chat_10",
          "speaker_ja": "謎の少女",
          "ko": "……이름……없습니다.",
          "source": "……名前……ないです。"
        }
      ]
    },
    {
      "uid": "46_1494572496_3",
      "scene": "Dialog100073_End",
      "rows": [
        {
          "uid": "46_1752574927_3",
          "key": "Dialog100073_End_1",
          "speaker_ja": "詩",
          "ko": "왠지 산의 샘물 같은 소리가 네요. ......어라? 뭔가 다른 소리도 섞여있는 것 같은 ......",
          "source": "なんだか山の湧き水みたいな音がしますね。……あれ？なんか他の音も混ざってるような……"
        },
        {
          "uid": "46_1494572496_3",
          "key": "Dialog100073_End_2",
          "speaker_ja": "詩",
          "ko": "저쪽에서 들립니다. 가자!",
          "source": "あっちのほうから聞こえます。行ってみましょう！"
        }
      ]
    }
  ]
}
