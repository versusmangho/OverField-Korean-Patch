  "samples": [
    {
      "uid": "46_2097680321_3",
      "scene": "Dialog101051_Chat",
      "rows": [
        {
          "uid": "46_796208594_3",
          "key": "Dialog101051_Chat_1",
          "speaker_ja": "ファンティーヌ",
          "ko": "정직하게 말하면, 연구원이 당신들이 모은 데이터로부터, 한 장의 나무 조각의 위치를 ​​산출했습니다.",
          "source": "正直に言うと、研究員があなたたちが集めたデータから、一枚の木片の位置を算出したんです。"
        },
        {
          "uid": "46_2097680321_3",
          "key": "Dialog101051_Chat_2",
          "speaker_ja": "詩",
          "ko": "대단해! 어떻게 했니? 그 연구원에게 물어 보자!",
          "source": "すごい！どうやってやったの？あの研究員に聞いてみよう！"
        },
        {
          "uid": "46_1121729543_3",
          "key": "Dialog101051_Chat_3",
          "speaker_ja": "ファンティーヌ",
          "ko": "가면의 모델로부터 조각의 형상을 역산하여 관측 데이터 중에서 발견했다.",
          "source": "仮面のモデルから欠片の形状を逆算し、観測データの中から見つけ出した。"
        }
      ]
    },
    {
      "uid": "46_1191639462_3",
      "scene": "Dialog109022_Chat",
      "rows": [
        {
          "uid": "46_1578689319_3",
          "key": "Dialog109022_Chat_19",
          "speaker_ja": "ミャオ",
          "ko": "――그렇지 않아! 시원하고 귀엽고, 모두의 눈이 반짝반짝 되는 새로운 메뉴의 이야기를 하고 있는 거야!",
          "source": "――そうじゃなくて！クールで可愛くて、みんなの目がキラッてなるような新メニューの話をしてるの！"
        },
        {
          "uid": "46_1191639462_3",
          "key": "Dialog109022_Chat_20",
          "speaker_ja": "ミャオ",
          "ko": "더 이상 어쩔 수 없어… … 그럼, 리더도 조금 도와주지 않아?",
          "source": "もうどうしようもないな……じゃあ、リーダーもちょっと手伝ってくれない？"
        },
        {
          "uid": "46_2105646809_3",
          "key": "Dialog109022_Chat_21",
          "speaker_ja": "ココ",
          "ko": "미야오, 스스로 결정한다고 말하지 않았습니까?",
          "source": "ミャオ、自分で決めるって言っていませんでしたか？"
        }
      ]
    },
    {
      "uid": "46_63315538_3",
      "scene": "Dialog106062_Chat",
      "rows": [
        {
          "uid": "46_747258566_3",
          "key": "Dialog106062_Chat_6",
          "speaker_ja": "ナオキ",
          "ko": "선배, 외모! 실험실 앞!",
          "source": "先輩、外見て！ラボの前！"
        },
        {
          "uid": "46_63315538_3",
          "key": "Dialog106062_Chat_7",
          "speaker_ja": "詩",
          "ko": "북과 동침의 소리… … 사자춤 일좌입니다!",
          "source": "太鼓と銅鑼の音……獅子舞一座です！"
        },
        {
          "uid": "46_1388380915_3",
          "key": "Dialog106062_Chat_8",
          "speaker_ja": "イェンイェン",
          "ko": "무려! 실험실 앞까지 공연하러 왔어요!",
          "source": "なんと！ラボの前まで公演しに来てくれたんですね！"
        }
      ]
    },
    {
      "uid": "46_1713027418_3",
      "scene": "Dialog101091_Chat",
      "rows": [
        {
          "uid": "46_1098775684_3",
          "key": "Dialog101091_Chat_4",
          "speaker_ja": "詩",
          "ko": "조금 기다려, 더 알고 싶은 것이 있는 거야! 제발, 먼저 이것을 말해!",
          "source": "ちょっと待って、もっと知りたいことがあるの！お願い、まずこれ教えて！"
        },
        {
          "uid": "46_1713027418_3",
          "key": "Dialog101091_Chat_5",
          "speaker_ja": "詩",
          "ko": "사키가 전에 숨어 있었을 때, 어디에 숨어 있었는지 알고 싶다!",
          "source": "咲が前に隠れてた時、どこに隠れてたのか知りたい！"
        }
      ]
    },
    {
      "uid": "46_1729517694_3",
      "scene": "Dialog104125_End",
      "rows": [
        {
          "uid": "46_1729517694_3",
          "key": "Dialog104125_End_0",
          "speaker_ja": "フェイ",
          "ko": "이 근처는 찾았습니다만, 특히 아무것도 발견되지 않네요. 코코, 도대체 무엇을 찾고 싶을까요…",
          "source": "この辺りは探しましたけど、特になにも見つからないですね。コッコ、一体なにを探してほしいんでしょう……"
        },
        {
          "uid": "46_191234585_3",
          "key": "Dialog104125_End_1",
          "speaker_ja": "詩",
          "ko": "코코이기 때문에, 뭔가 이유가 있을 것입니다.",
          "source": "コッコのことですから、なにか理由があるはずです。"
        }
      ]
    }
  ]
}
