      "rows": [
        {
          "uid": "46_1344487897_3",
          "key": "Dialog102121_Chat_10",
          "speaker_ja": "フェイ",
          "ko": "그러나 우리가 그것을 발견했을 때, 흰 드레스를 입은 소녀를 보았습니다.",
          "source": "しかし、私たちがそれを見つけた時、白いドレスを着た女の子を見かけました。"
        },
        {
          "uid": "46_397297695_3",
          "key": "Dialog102121_Chat_11",
          "speaker_ja": "部長",
          "ko": "……! 하얀 스커트의……소녀……?",
          "source": "……！白いスカートの……女の子……？"
        },
        {
          "uid": "46_1650852439_3",
          "key": "Dialog102121_Chat_12",
          "speaker_ja": "フェイ",
          "ko": "그 소녀가 누군지 모르는, 하롱일지도 모르지만, 그 아이일지도 모르고, 혹은 다른 사람…",
          "source": "あの女の子が誰か分からない、ハロンかもしれないけど、あの子かもしれないし、あるいは他の人……"
        }
      ]
    },
    {
      "uid": "46_44491666_3",
      "scene": "Dialog220043_Chat",
      "rows": [
        {
          "uid": "46_44491666_3",
          "key": "Dialog220043_Chat_0",
          "speaker_ja": "詩",
          "ko": "——원래광회 내운탑 시인 为你已经来当探索员了啊!",
          "source": "——原来光会来罗塔是因为你已经来当探索员了啊！"
        },
        {
          "uid": "46_2042501837_3",
          "key": "Dialog220043_Chat_1",
          "speaker_ja": "ヒカリ",
          "ko": "사람이 많다…",
          "source": "人が多い…"
        }
      ]
    },
    {
      "uid": "46_1244500951_3",
      "scene": "Dialog104141_Chat",
      "rows": [
        {
          "uid": "46_832959280_3",
          "key": "Dialog104141_Chat_14",
          "speaker_ja": "コクマ",
          "ko": "앞서 말했듯이, 나는 수리하는 동안 변이기에 발신기를 붙였습니다.",
          "source": "先ほど言った通り、私は修復中に、変異器に発信機をつけました。"
        },
        {
          "uid": "46_1244500951_3",
          "key": "Dialog104141_Chat_15",
          "speaker_ja": "コクマ",
          "ko": "나비에 들키지 않는 한 그녀를 찾을 기회는 여전히 남아 있습니다.",
          "source": "蝶子にバレない限り、彼女を見つけるチャンスはまだ残っています。"
        },
        {
          "uid": "46_1055653973_3",
          "key": "Dialog104141_Chat_16",
          "speaker_ja": "ファンティーヌ",
          "ko": "조금 기다려. 방금 지금 변이체 변이체가 출현했다는 연락이 왔다.",
          "source": "ちょっと待って。たった今、灰物変異体が出現したという連絡がきたわ。"
        }
      ]
    },
    {
      "uid": "46_628982661_3",
      "scene": "Dialog109052_Chat",
      "rows": [
        {
          "uid": "46_1563668677_3",
          "key": "Dialog109052_Chat_21",
          "speaker_ja": "詩",
          "ko": "위험한 눈에는 당하지 않는다고 생각하기 때문에!",
          "source": "危ない目には遭わないと思いますから！"
        },
        {
          "uid": "46_628982661_3",
          "key": "Dialog109052_Chat_22",
          "speaker_ja": "コク",
          "ko": "당신의 예감은 항상 옳다. 가자.",
          "source": "あなたの予感はいつも正しい。行こう。"
        }
      ]
    },
    {
      "uid": "46_129335106_3",
      "scene": "Dialog106052_End",
      "rows": [
        {
          "uid": "46_1865193176_3",
          "key": "Dialog106052_End_6",
          "speaker_ja": "フェイ",
          "ko": "갑자기 말씀하셔도 저도…… 흐름의 방향을 유도하는 건 완전히 원소화된 상태에서만 가능해요.",
          "source": "急に言われても私も……流れの方向を誘導するには、完全に元素化した状況にしか適用できません。"
        },
        {
          "uid": "46_129335106_3",
          "key": "Dialog106052_End_7",
          "speaker_ja": "フェイ",
          "ko": "식재료 같은 불안정한 물체는 완전히 인리움화되어 있지 않기 때문에 제어가 어렵고…",
          "source": "食材みたいな不安定な物体は、完全にインリウム化してないので制御が難しくて……"
        },
        {
          "uid": "46_1980990952_3",
          "key": "Dialog106052_End_8",
          "speaker_ja": "詩",
          "ko": "미안해, 전에 멜 커버를 해결했을 때와 같은 원리라고 생각했으니까…",
          "source": "ごめんなさい、前にメルカバーを解決した時と同じ原理だと思ってましたから……"
        }
      ]
    }
  ]
