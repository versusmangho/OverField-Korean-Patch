  "samples": [
    {
      "uid": "46_1747914020_3",
      "scene": "Dialog108015_Chat",
      "rows": [
        {
          "uid": "46_860608799_3",
          "key": "Dialog108015_Chat_52",
          "speaker_ja": "ミリア",
          "ko": "그래, 페이! 찾아 주셔서 감사합니다. 임무는 완벽하게 처리되었습니다! 수고하셨습니다!",
          "source": "うん、フェイ！見つけてくれてありがとう、任務は完璧にこなしたね！お疲れ様！"
        },
        {
          "uid": "46_1747914020_3",
          "key": "Dialog108015_Chat_53",
          "speaker_ja": "フェイ",
          "ko": "수고하셨습니다! 그럼, 함께 옌옌에게 보고하자~",
          "source": "お疲れ様でした！それじゃあ、一緒にイェンイェンのところへ報告に行きましょう～"
        }
      ]
    },
    {
      "uid": "46_1027199724_3",
      "scene": "Dialog108015_Chat",
      "rows": [
        {
          "uid": "46_1929708585_3",
          "key": "Dialog108015_Chat_49",
          "speaker_ja": "詩",
          "ko": "어? 나는 경찰관이나 장관 같은 이름이 없다?",
          "source": "え？私は警官や長官のような呼び名がないんですか？"
        },
        {
          "uid": "46_1027199724_3",
          "key": "Dialog108015_Chat_50",
          "speaker_ja": "ミリア",
          "ko": "카렌보...가 아니라, 은밀 임무는 이미 끝났어! 지금은 퇴근한 경찰이야!",
          "source": "かくれんぼ...じゃなくて、隠密任務はもう終わったんだ！今のリーは退勤した警官だよ！"
        },
        {
          "uid": "46_596705208_3",
          "key": "Dialog108015_Chat_51",
          "speaker_ja": "フェイ",
          "ko": "그렇다면 내 이름도 페이라고 불러도 될까요?",
          "source": "それなら、私の名前もフェイって呼んでもらってもいいですか？"
        }
      ]
    },
    {
      "uid": "46_1949857071_3",
      "scene": "Dialog106062_Chat",
      "rows": [
        {
          "uid": "46_897272472_3",
          "key": "Dialog106062_Chat_15",
          "speaker_ja": "フェイ",
          "ko": "수고하셨습니다. 사자춤 일좌의 좌장씨군요. 회의실에서 만났습니다.",
          "source": "お疲れ様です。獅子舞一座の座長さんですね。会議室でお会いしました。"
        },
        {
          "uid": "46_1949857071_3",
          "key": "Dialog106062_Chat_16",
          "speaker_ja": "詩",
          "ko": "라고 하는 것은, 이 쪽이 호랑이씨의 「스승」입니까?",
          "source": "ということは、この方がトラさんの「師匠」ですか？"
        },
        {
          "uid": "46_1199658403_3",
          "key": "Dialog106062_Chat_17",
          "speaker_ja": "座長",
          "ko": "그래, 내가 토라가 말한 스승이란다. 이 나이에 대단한 걸 가르쳐 줄 수는 없지만 말이야.",
          "source": "そうじゃ、ワシがトラの言う「師匠」じゃよ。もうこの歳じゃから、大したことは教えられんがな。"
        }
      ]
    },
    {
      "uid": "46_2008933185_3",
      "scene": "Dialog100034_End",
      "rows": [
        {
          "uid": "46_127117952_3",
          "key": "Dialog100034_End_8",
          "speaker_ja": "詩",
          "ko": "… … 우리들, 어떻게 내리면 좋을까요?",
          "source": "……あたしたち、どうやって降りたらいいんでしょうね？"
        },
        {
          "uid": "46_2008933185_3",
          "key": "Dialog100034_End_9",
          "speaker_ja": "フェイ",
          "ko": "내리는 방법을 모르는 채, 그런 높은 곳까지 갔습니까? 무서워하지 않았습니까?",
          "source": "降り方がわからないまま、あんな高いところまで行ったんですか……？怖くはなかったんですか？"
        },
        {
          "uid": "46_413422697_3",
          "key": "Dialog100034_End_10",
          "speaker_ja": "詩",
          "ko": "전혀! 왜냐하면 매우 즐거웠고!",
          "source": "全然！だって、すごく楽しかったですし！"
        }
      ]
    },
    {
      "uid": "46_1773434882_3",
      "scene": "Dialog106053_End",
      "rows": [
        {
          "uid": "46_1773434882_3",
          "key": "Dialog106053_End_0",
          "speaker_ja": "フェイ",
          "ko": "반대로 식재료 속의 불안정한 원소를 유도해 밖으로 내면…",
          "source": "逆に食材の中の不安定な元素を誘導して外に出せば……"
        },
        {
          "uid": "46_316081896_3",
          "key": "Dialog106053_End_1",
          "speaker_ja": "フェイ",
          "ko": "식재료로 환원될 때 멜커버처럼 필드의 배척반응으로 매우 불안정해질 것입니다.",
          "source": "食材に還元される時、メルカバーみたいにフィールドの排斥反応で極めて不安定になるはずです。"
        }
      ]
    }
  ]
}
